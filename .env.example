# Copy to .env.local and fill in real values:
#   cp .env.example .env.local
#
# Input names are uppercased with an INPUT_ prefix.
# Hyphens in input names stay as hyphens; underscores stay as underscores.

INPUT_API_TOKEN=vaultify_token_xxxxxxxxxxxxxx
# Optional:
# INPUT_CATEGORY_ID=your-category-id
INPUT_PER_PAGE=100
INPUT_EXPORT_ENV=false
INPUT_WRITE_FILES=key.properties=/tmp/vaultify-one/key.properties
